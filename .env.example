# Production defaults to $HOME/.local/share/docheng-platform, outside the deployment tree.
# Override with an absolute persistent directory and include it in backups.
# DOCHENG_DATA_DIR=/home/ACCOUNT/.local/share/docheng-platform
DOCHENG_ORIGIN=https://www.docheng.co.za
DOCHENG_TRUST_PROXY=0
# Verified Resend sending domain required. Never use NEXT_PUBLIC_ for secrets.
RESEND_API_KEY=
DOCHENG_MAIL_FROM=
DOCHENG_SUPPORT_EMAIL=
# Hostinger Mail can be used instead of Resend. Scope the token to this mailbox only.
HOSTINGER_MAIL_TOKEN=
HOSTINGER_MAILBOX_ID=
# Set to the owner's explicitly authorized email only; the account must verify ownership.
DOCHENG_BOOTSTRAP_ADMIN_EMAIL=
# Paid billing is intentionally inactive. Live payment keys require owner approval.
